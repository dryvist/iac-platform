# Copy to compose/.env (gitignored) and keep it non-secret: image pins, ports,
# identifiers. Real-domain values (DOMAIN, TK_OUTPUT_ENDPOINT, DEPLOY_HOST,
# OPENBAO_OIDC_ISSUER, SEMAPHORE_ADMIN_EMAIL) and every runtime secret come from OpenBao
# (secret/platform/terrakube/main) via scripts/openbao-exec-env.sh at deploy
# time — never in this file.

# Image pins (renovate-tracked)
TK_VERSION=2.28.0
TK_DEX_VERSION=v2.42.0
TK_REDIS_VERSION=8-alpine
TK_POSTGRESQL_VERSION=17
SEMAPHORE_VERSION=v2.18.18

# Host ports Traefik backs onto — must match iac_platform_ports in
# tofu-proxmox constants.tf (the ingress rows reference those constants).
PORT_TERRAKUBE_UI=28080
PORT_TERRAKUBE_API=28081
PORT_TERRAKUBE_REGISTRY=28082
PORT_TERRAKUBE_DEX=28083
PORT_SEMAPHORE=28084

# Terrakube database + storage identifiers (values, not credentials).
TK_POSTGRESQL_USERNAME=terrakube
TK_POSTGRESQL_DATABASE_NAME=terrakubedb
TK_OUTPUT_BUCKET_NAME=terrakube
TK_OUTPUT_STORAGE_REGION=us-east-1
TK_OUTPUT_BUCKET_REGION=us-east-1

# GitHub org and team whose members may log in. Dex's connector grants exactly
# this team, and docker-compose composes TERRAKUBE_ADMIN_GROUP as
# "${DEX_GITHUB_ORG}:${DEX_GITHUB_TEAM}" — the org-qualified shape the GitHub
# connector emits and the terrakube_team resource in tofu/terrakube builds.
# Set these two and nothing else; do not add TERRAKUBE_ADMIN_GROUP by hand.
# DEX_GITHUB_TEAM is the team SLUG (teamNameField: slug), not its display name.
# The OAuth app's client id/secret come from OpenBao, never this file.
DEX_GITHUB_ORG=your-github-org
DEX_GITHUB_TEAM=terrakube-admins

# Public identifier for Terrakube's per-job workload-identity signing key.
# The public/private PEM values remain in OpenBao, not this file.
TK_DYNAMIC_CREDENTIAL_KEY_ID=terrakube-openbao-v1

# OIDC client id Dex presents to Authelia on the `authelia` connector. It must
# match the client registered on the Authelia side (ansible-proxmox-apps,
# roles/authelia). A client id is a public identifier, so it belongs here; only
# its secret lives in OpenBao (secret/apps/authelia).
DEX_AUTHELIA_CLIENT_ID=terrakube-dex
