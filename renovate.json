{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>JacobPEvans/.github"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/^compose/docker-compose\\.yml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release tags of the Ansible repositories Semaphore deploys, annotated above each branch value in the ansible_repositories default",
      "managerFilePatterns": [
        "/^tofu/semaphore/variables\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+branch\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "uv release pin in the Semaphore runner image",
      "managerFilePatterns": [
        "/^compose/semaphore/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG UV_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Update first-party Semaphore deploy refs as soon as each release lands, one pull request per repository, outside the organization schedule, grouping, and release-age delay.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "tofu/semaphore/variables.tf"
      ],
      "schedule": [
        "at any time"
      ],
      "groupName": null,
      "minimumReleaseAge": "0 days",
      "dependencyDashboardApproval": false,
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
